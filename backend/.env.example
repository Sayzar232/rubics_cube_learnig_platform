SECRET_KEY=change-me-in-production-secret-key-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Канонический адрес сайта для canonical/og:url/sitemap (в проде https://cubelearn.site)
SITE_URL=https://cubelearn.site
# /docs, /redoc и /openapi.json: локально удобно включить, в проде держим выключенными
ENABLE_API_DOCS=true
# Дополнительные хосты для X-Robots-Tag: noindex (api.<домен SITE_URL> учитывается сам)
NOINDEX_HOSTS=
POSTGRES_DB=cfop_db
POSTGRES_USER=cfop_user
POSTGRES_PASSWORD=cfop_password
DATABASE_URL=postgresql+psycopg2://cfop_user:cfop_password@db:5432/cfop_db
