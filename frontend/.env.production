# Прод-значения для сборки (npm run build). Коммитится в репозиторий, чтобы
# локальная сборка dist давала те же ассеты, что и сборка Vercel: серверный HTML
# (Render) ссылается на /assets/index-<hash>.js из закоммиченного dist, и этот
# файл обязан существовать на основном домене. Пока здесь были значения из
# локального frontend/.env (localhost), хэши расходились и SPA не запускалась.
VITE_API_URL=https://api.cubelearn.site
VITE_SITE_URL=https://cubelearn.site
